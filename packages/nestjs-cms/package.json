{
  "name": "@arkv/nestjs-cms",
  "version": "0.2.0",
  "description": "Pluggable NestJS admin CMS — auto-generates a dashboard from your OpenAPI/Swagger spec",
  "keywords": [
    "admin",
    "cms",
    "dashboard",
    "nestjs",
    "openapi",
    "swagger",
    "typescript"
  ],
  "homepage": "https://github.com/petarzarkov/arkv/tree/main/packages/nestjs-cms#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/arkv",
    "directory": "packages/nestjs-cms"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build:ui": "cd frontend && bunx vite build",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build": "bun run build:ui && bun run --parallel build:esm build:cjs build:types",
    "postbuild": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck": "tsc --noEmit",
    "dev:ui": "cd frontend && bunx vite",
    "dev:ts": "tsc -p tsconfig.build.esm.json --watch --preserveWatchOutput",
    "dev": "bun run --parallel dev:ui dev:ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/dates": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@tanstack/react-query": "5.80.7",
    "@types/express": "5.0.6",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "dayjs": "1.11.13",
    "fastify": "5.8.4",
    "framer-motion": "12.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "6.3.5",
    "zustand": "5.0.5"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/swagger": "11.2.7",
    "fastify": ">=4",
    "reflect-metadata": "0.2.2"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
