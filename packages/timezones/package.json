{
  "name": "@arkv/timezones",
  "version": "0.0.2",
  "description": "Auto-generated IANA timezone data with rich metadata, no dependencies, full TypeScript support, and Node/browser compatibility.",
  "keywords": [
    "date",
    "datetime",
    "db",
    "gmt",
    "iana",
    "json",
    "list",
    "no deps",
    "offset",
    "static data",
    "time",
    "timezone",
    "timezone offset",
    "timezones",
    "typescript",
    "tz",
    "tzdb",
    "utc"
  ],
  "homepage": "https://github.com/petarzarkov/arkv/tree/main/packages/timezones#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/arkv",
    "directory": "packages/timezones"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build": "bun run --parallel build:esm build:cjs build:types",
    "postbuild": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "generate": "bun ./scripts/generate.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/tar-stream": "3.1.4",
    "csv-parse": "6.2.1",
    "tar-stream": "3.2.0"
  }
}
